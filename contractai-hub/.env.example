# =============================================================================
# EnContract — local development environment variables
# Copy this file to `.env` and fill in the values you need. Lines left blank
# simply keep the defaults used in code (see src/lib/supabase.client.ts and
# src/lib/ai.server.ts for fallbacks).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — the production backend for this project.
#
# Copy these values from your Supabase Project Settings → API.
#
# When these are set, EnContract uses:
#   · Supabase Auth (email/password + Google OAuth)
#   · Supabase Storage for uploaded contract PDFs
#   · Supabase Database / Server Functions for contract analysis & data
#
# If you leave them blank, the app falls back to a local-only demo mode
# (localStorage + IndexedDB + mock auth) so you can still run it end-to-end.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://aguwurnkteisuqhqoyqg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7IphXYXx2j5xYSip68H7fw_1ploxn5l
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://aguwurnkteisuqhqoyqg.supabase.co/auth/v1/.well-known/jwks.json

VITE_SUPABASE_URL=https://aguwurnkteisuqhqoyqg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7IphXYXx2j5xYSip68H7fw_1ploxn5l

# -----------------------------------------------------------------------------
# Local Ollama AI — used for contract analysis and the AI assistant.
#
# Runs on your machine: install Ollama (https://ollama.com), then:
#   `ollama serve`       (launches the API on http://localhost:11434)
#   `ollama pull phi4`   (or any chat model)
#
# OLLAMA_MODEL forces a specific model name when you have several pulled
# (e.g. "deepseek-v3", "llama3.1:8b", "qwen2.5:14b"). Leave blank to auto-pick
# the strongest installed model.
# -----------------------------------------------------------------------------
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_API_KEY=ollama
VITE_OLLAMA_MODEL=

# Server-side counterparts (same semantics) — set these if your hosting
# provider or self-hosted server needs different values:
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
